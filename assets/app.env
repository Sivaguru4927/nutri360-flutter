# Nutri360 Environment Variables Template
# ─────────────────────────────────────────────────────────────
# HOW TO USE:
#   Copy this file to ".env" and fill in your real credentials.
#   The .env file is NEVER committed to Git (see .gitignore).
#   Flutter reads it at build time via flutter_dotenv.
# ─────────────────────────────────────────────────────────────

# ── Supabase Credentials ─────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App Mode ────────────────────────────────────────────────
APP_ENV=development
ENABLE_DEMO_MODE=true

# ── MongoDB Atlas App Services (Stitch) ──────────────────────
ATLAS_APP_ID=nutri360-stitch-xxxxx
ATLAS_BASE_URL=https://services.cloud.mongodb.com
